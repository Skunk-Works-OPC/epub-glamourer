<!DOCTYPE html>
<html lang="{{language}}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Preview: {{title}}</title>
  <link rel="stylesheet" href="/assets/main.css"/>
  <style>
    body { display: flex; margin: 0; padding: 0; background: #f0ede8; font-family: Georgia, serif; }
    #preview-nav {
      width: 220px;
      min-width: 220px;
      background: #1e3a5f;
      color: #faf7f2;
      padding: 1.5em 1em;
      height: 100vh;
      overflow-y: auto;
      position: sticky;
      top: 0;
    }
    #preview-nav h2 {
      color: #b8924a;
      font-size: 0.75em;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      margin-bottom: 1em;
      border-bottom: 1px solid rgba(184,146,74,0.4);
      padding-bottom: 0.5em;
    }
    #preview-nav a {
      display: block;
      color: #faf7f2;
      text-decoration: none;
      padding: 0.35em 0.5em;
      font-size: 0.85em;
      border-radius: 3px;
      margin-bottom: 2px;
    }
    #preview-nav a:hover,
    #preview-nav a.active { background: rgba(184,146,74,0.25); color: #b8924a; }
    #preview-frame {
      flex: 1;
      padding: 2em;
      max-width: 860px;
      background: #faf7f2;
      min-height: 100vh;
    }
    .preview-banner {
      background: #1e3a5f;
      color: #faf7f2;
      padding: 0.75em 1.5em;
      font-size: 0.8em;
      letter-spacing: 0.05em;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }
    .preview-banner span { color: #b8924a; }
  </style>
</head>
<body>
  <nav id="preview-nav">
    <h2>Chapters</h2>
    {{#each chapters}}
    <a href="/chapter/{{id}}" data-id="{{id}}">{{title}}</a>
    {{/each}}
  </nav>
  <div style="flex:1; display:flex; flex-direction:column;">
    <div class="preview-banner">
      <span>epub-glamourer preview</span>
      <span>{{title}}</span>
    </div>
    <div id="preview-frame">
      {{{content}}}
    </div>
  </div>
  <script>
    const links = document.querySelectorAll('#preview-nav a');
    links.forEach(link => {
      link.addEventListener('click', async (e) => {
        e.preventDefault();
        const id = link.dataset.id;
        const res = await fetch('/chapter/' + id);
        const html = await res.text();
        document.getElementById('preview-frame').innerHTML = html;
        links.forEach(l => l.classList.remove('active'));
        link.classList.add('active');
        window.scrollTo(0, 0);
      });
    });
    if (links.length) links[0].classList.add('active');
  </script>
</body>
</html>
