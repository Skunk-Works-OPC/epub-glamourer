{
  "name": "epub-glamourer",
  "version": "1.0.0",
  "description": "Apply publisher-quality glamour styling to EPUB3 files",
  "bin": {
    "epub-glamour": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/cli.ts",
    "preview:pages": "npm run build && node dist/page-dev.js",
    "start": "node dist/cli.js",
    "test": "jest",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint 'src/**/*.ts'",
    "build:model": "npm run build && node scripts/build-model.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cheerio": "^1.0.0",
    "commander": "^12.0.0",
    "epubjs-cli": "^0.2.2",
    "express": "^4.18.3",
    "fast-xml-parser": "^4.3.6",
    "fs-extra": "^11.2.0",
    "handlebars": "^4.7.8",
    "jszip": "^3.10.1",
    "mammoth": "^1.7.1",
    "marked": "^12.0.0",
    "open": "^10.1.0",
    "ora": "^8.0.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.60.0",
    "uuid": "^9.0.1",
    "xmlbuilder2": "^3.1.1"
  },
  "devDependencies": {
    "@fontsource/lora": "^5.2.8",
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
